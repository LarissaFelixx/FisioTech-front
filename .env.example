# Copie este arquivo para `.env` (que NÃO é commitado) e ajuste os valores.
# Variáveis com prefixo EXPO_PUBLIC_ ficam disponíveis no app em process.env.
# Não coloque segredos aqui: tudo que começa com EXPO_PUBLIC_ vai embutido no bundle.

# URL base da API do backend FisioTech (Spring Boot), sem barra no final.
#
# - Emulador Android: `localhost` dentro do emulador é o próprio emulador.
#   Use 10.0.2.2, que aponta para a máquina host:
#     EXPO_PUBLIC_API_URL=http://10.0.2.2:8080
# - Celular físico (Expo Go ou APK): use o IP da sua máquina na rede Wi-Fi
#   (celular e PC na mesma rede), ex.:
#     EXPO_PUBLIC_API_URL=http://192.168.0.10:8080
#
# Atenção: a porta 8081 é usada pelo Metro (servidor de desenvolvimento do Expo).
# Rode o backend em outra porta (padrão do Spring Boot: 8080).
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080
